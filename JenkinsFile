pipeline {
    agent any

    tools {
        maven 'M3' // Must match the name configured in Jenkins Global Tool Configuration
        jdk 'JDK 17'      // Must match the name configured in Jenkins Global Tool Configuration
    }

    stages {
        stage('Clone Repository') {
            steps {
                checkout scm
            }
        }

        stage('Clean & Compile Workspace') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Execute Core Testing Framework') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package Application Archetype') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
    }

    post {
        success {
            echo 'Deployment verification check completed successfully.'
        }
        failure {
            echo 'Failure detected during pipeline lifecycle compilation or verification tests.'
        }
    }
}
